auto-reload no
show-read-feeds no
show-read-articles no

refresh-on-startup yes
reload-threads 100

browser "/usr/bin/xdg-open %u"

urls-source "miniflux"
miniflux-url "https://news.noleron.com"

miniflux-login "fakeowl1"
miniflux-password "Tav9eDcmmAj2y#@B"

include /usr/share/doc/newsboat/contrib/colorschemes/solarized-dark

bind-key h quit
bind-key j down
bind-key k up
bind-key l open
bind-key H prev-feed
bind-key L next-feed
bind-key g home
bind-key G end
bind-key SPACE macro-prefix 
bind-key b bookmark 
bind-key ^F pagedown 
bind-key ^B pageup 
bind-key ^H toggle-show-read-feeds 

macro m set browser "mpv --really-quiet %u" ; open-in-browser ; set browser "xdg-open %u"
macro w set browser "w3m %u" ; open-in-browser ; set browser "xdg-open %u"

# highlights
highlight article "^(Feed):.*$" color6 default bold
highlight article "^(Title|Date|Author):.*$" color6 default bold
highlight article "https?://[^ ]+" color10 default underline
highlight article "\\[[0-9]+\\]" color10 default bold
highlight article "\\[image\\ [0-9]+\\]" color10 default bold
