{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,

  "modules-left": ["sway/workspaces", "custom/sep", "sway/window"],
  "modules-center": [],
  "modules-right": [
    "tray", 
    "custom/sep",
    "bluetooth", 
    "custom/sep",
    "pulseaudio", 
    "custom/sep",
    "sway/language", 
    "custom/sep",
    "battery", 
    "custom/sep",
    "clock"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "sway/window": {
    "format": "{}",
    "max-length": 50
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED"
  },

  "sway/language": {
    "format": " {short}"
  },

  "battery": {
    "format": "BAT {capacity}%"
  },

  "clock": {
    "format": "{:%a, %b %d %I:%M %p}"
  },

  "bluetooth": {
    "format": "BT {status}"
  },

  "custom/sep": {
    "format": "|",
    "tooltip": false
  }
}
