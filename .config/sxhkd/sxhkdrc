# Volume control
# ----------------------------------------------------------

# Down
{F2,XF86AudioLowerVolume}
  $HOME/bin/media-control volume_down

# Up
{F3,XF86AudioRaiseVolume}
  $HOME/bin/media-control volume_up

# Mute
{F1,F86AudioMute}
  $HOME/bin/media-control volume_mute

# Mute mic
{F9,XF86AudioMicMute}
  $HOME/bin/media-control mic_mute

shift + {F9,XF86AudioMicMute}
  $HOME/bin/media-control mic_up

ctrl + {F9,XF86AudioMicMute}
  $HOME/bin/media-control mic_down

