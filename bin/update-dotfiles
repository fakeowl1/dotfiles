#!/bin/bash

export DISPLAY=:0

DOTFILES_DIR=$HOME/.cfg

function dotfiles {
  git --git-dir=$DOTFILES_DIR --work-tree=$HOME "$@"
}

check=$(dotfiles status -s)

if [ -n "$check" ]; then
  dotfiles add -u
  dotfiles commit -m "$(date +'%a, %b %d %H:%M') update configs"

  if dotfiles push origin main; then
    notify-send "Dotfiles" "$(date +'%d.%m.%Y') configs have updated" -t 4000
  else 
    notify-send "Dotfiles" "Push failed! Check your connection." -u critical
  fi
else
  notify-send "Your configs up-to-date"
fi
