#!/bin/bash

source student.env

# Display Help

usage() {
cat << EOF
Usage: lab-gen [<discipline name>] [<type>] [<number of work>],
the path must be .../discipline/type/smth_number or manually: lab-gen lab okr 1

OPTIONS:
  -h show this message
EOF
}

if [ $# -eq 0 ]; then 
  current_path=$PWD

  courseNumber=$(echo "$current_path" | sed -E 's|.*uni/[^0-9]*([0-9]+).*|\1|')
  work_type=$(echo $current_path | sed -E "s|.*/||")
  discipline=$(echo "$current_path" | sed -E 's|.*uni/([0-9]+/)+([^/]+).*|\2|')
  number=$(echo "$current_path" | sed -E 's|.*lab([0-9]+).*|\1|')
fi

if [ $# -gt 2 ]; then
  usage 
  exit 1
fi

declare -i number=$1

prefix=

shift

if [ -z "$prefix" ]; then
  usage
  echo
  echo "Fail: template is required"
fi

template_path="$UNI/.templates/"

baseinfo_path="$template_path/parts/baseinfo.tex"

first_name=$(sed -n 's/\\newcommand\\Fname{\([^}]*\)}/\1/p' "$template_path/parts/baseinfo.tex")
last_name=$(sed -n 's/\\newcommand\\Lname{\([^}]*\)}/\1/p' "$template_path/parts/baseinfo.tex")
group=$(sed -n 's/\\newcommand\\Group{\([^}]*\)}/\1/p' "$template_path/parts/baseinfo.tex")

reportName="$group_$first_name_$last_name_Лаб$number.tex"

codefiles=$(find . -maxdepth 2 -regex '.*/*\.\(cpp\|cs\|ino\|c\|py\|sh\|java\)$')
outs=$(find . -maxdepth 2 -iname out)

for file in $codefiles ; do
	ext="${file##*.}"
	[ $ext = "ino" ] && ext=cpp
	listings=$listings"### Файл $file: \n\\\inputminted{$ext}{$file}\n\n"
done

for file in $outs ; do
	ext="${file##*.}"
	listings=$listings"### Вивід $file: \n\\\inputminted{text}{$file}\n\n"
done

echo -e $listings

graphics=$(find . -regex '.*/*\.\(jpg\|png\|svg\)$')

for file in $graphics ; do
	ext="${file##*.}"
	figures=$figures"![<++>]($file)\n\n"
done

echo -e $figures

body=$listings"\n\\\clearpage\n# Рисунки\n$figures" 
