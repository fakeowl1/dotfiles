#!/bin/bash

source student.env

# Display Help

usage() {
cat << EOF
Usage: lab-gen [number of work] [template]
Example: lab-gen 1 -s

Automaticaly create a lab report

OPTIONS:
  -h show this message
  -c generate template for okr lab
  -p generate template for phys lab
  -s generate template for sysp lab
EOF
}
if [ $# -lt 1 ]; then
  usage 
  exit 1
fi

declare -i number=$1

if [ $number -eq 0 ]; then
  echo "Error: First argument must be a number."
  usage
  exit 1
fi

prefix="general"

shift

while getopts ':hcps' OPTION
do 
  case $OPTION in 
    h) usage; exit 1 ;;
    c) 
      discipline="Основи Клієнтської розробки"
      prefix="okr"
      instructor="Хмелюк М.C"
      echo
      read -p "Enter work topic: " topic
      ;;
    p)
      discipline="Фізика"
      prefix="phys"
      instructor="Колган В.В"
      echo
      read -p "Enter work topic: " topic
      ;;
    s)
      discipline="Системне Програмування"
      prefix="sysp"
      instructor="Павлов В.Г"
      echo
      read -p "Enter work topic: " topic
      ;;
    ?) usage; exit 1 ;;
  esac
done

if [ $prefix = "general" ]; then
  echo
  read -p "Enter discipline: " discipline
  echo
  read -p "Enter instructor name: " instructor
fi

echo "---"
echo "Створюємо лабу №$number"
echo "Дисципліна: $discipline"
echo "Викладач: $instructor"
echo "Тема: $topic"

reportPath="$PWD/report.tex"
templatesPath="$HOME/.templates"

report_filename="${prefix}_report.tex"
template_filename="${prefix}_template.tex"

cp "$templatesPath/${report_filename}" report.tex
cp "$templatesPath/${template_filename}" template.tex

mkdir assets

variables=($(grep -Po '(?<=\{\$)\w+(?=\})' $reportPath))

for var in "${variables[@]}"; do
  value="${!var}"
  sed -i "s/{\\\$$var}/{$value}/g" "$reportPath"
done

nvim $reportPath +VimtexCompile
