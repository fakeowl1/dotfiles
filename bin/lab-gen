#!/bin/bash

# Display Help

usage() {
cat << EOF
Usage: lab-gen [<discipline name>] [<type>] [<number of work>],
the path must be .../discipline/type/smth_number or manually: lab-gen lab okr 1

OPTIONS:
  -h show this message
EOF
}

if [ $# -gt 3 ]; then
  usage
  exit 1
fi

if [ $# -eq 0 ]; then 
  current_path=$PWD
  
  number=$(basename "$current_path")
  workType=$(basename "$(dirname "$current_path")")
  discipline=$(basename "$(dirname "$(dirname "$current_path")")")
else
  discipline=$1
  workType=$2
  number=$3
fi

if [ -z "$discipline" ] || [ -z "$workType" ] || [ -z "$number" ]; then
  usage
  echo -e "\nFail: Cannot determine discipline, type, or number."
  exit 1
fi

template_path="$UNI/.templates"

baseinfo_path="$template_path/settings/baseinfo.tex"

first_name=$(sed -n '/Fname/{s/.*{\([^}]*\)}.*/\1/p}' "$baseinfo_path")
last_name=$(sed -n '/Lname/{s/.*{\([^}]*\)}.*/\1/p}' "$baseinfo_path")
group=$(sed -n '/Group/{s/.*{\([^}]*\)}.*/\1/p}' "$baseinfo_path")

filename="${group}_${first_name}_${last_name}_Лаб${number}.md"

report_path="$template_path/parts/${discipline}_part.md"
if [ ! -f $report_path ]; then
  report_path="$template_path/parts/general_part.md"
fi

cp $report_path "$filename"

codefiles=$(find . -maxdepth 2 -regex '.*/*\.\(cpp\|cs\|ino\|c\|py\|sh\|java\|go\)$')

listings=""
for file in $codefiles ; do
    ext="${file##*.}"
    [ "$ext" = "ino" ] && ext=cpp
    
    printf -v listings '%s### Файл %s:\n\\inputminted{%s}{%s}\n\n' "$listings" "$file" "$ext" "$file"
done

graphics=$(find . -regextype posix-extended -regex '.*\.(jpg|png|svg)$')

figures="" 
for file in $graphics; do 
    figures+="\\begin{figure}[H] 
\\centering 
\\includegraphics[width=0.8\\textwidth,height=0.8\\textheight,keepaspectratio]{$file} 
\\caption{<++>} 
\\end{figure} 

" 
done

body="$listings
\\clearpage
# Демонстрація роботи 
$figures"

bodyfile=$(mktemp)
printf '%s\n' "$body" > "$bodyfile"

sed -i "s|NUMBER|$number|g;
s|VARIANT|$variant|g;
s|TYPE|$workType|g;
s|DISCIPLINE|$discipline|g" "$filename"

sed -i "/BODY/{
r $bodyfile
d
}" "$filename"

rm -f "$bodyfile"
